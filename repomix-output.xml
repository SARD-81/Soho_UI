        id: user.id,
        username: user.username,
        email: user.email,
        firstName: user.first_name ?? '',
        lastName: user.last_name ?? '',
        dateJoined: formatUtcDateTimeToIran(user.date_joined) ?? '—',
      }))
      .sort((a, b) => a.id - b.id);
  }, [usersQuery.data]);

  const existingUsernames = useMemo(
