              {title}
            </Typography>
          </Stack>

          <Stack
            direction="row"
            alignItems="center"
            gap={1}
            sx={{
              minWidth: 0,
              flexShrink: 0,
              flexWrap: "wrap",
              justifyContent: { xs: "flex-start", md: "flex-end" },
            }}
          >
            {badges.map((badge) => (
              <Chip
                key={badge.label}
                size="small"
                variant="outlined"
                label={badge.label}
                color={badge.color ?? "default"}
