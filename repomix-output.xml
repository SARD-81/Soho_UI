function LoginPage() {
  return (
    <Box
      component="main"
      sx={{
        minHeight: '100svh',
        display: 'grid',
        placeItems: 'center',
        position: 'relative',
        overflow: 'hidden',
        px: { xs: 2, sm: 3 },
        py: { xs: 5, md: 8 },
        fontFamily: 'var(--font-vazir)',
        background: (theme) =>
          theme.palette.mode === 'dark'
            ? 'linear-gradient(135deg, #081421 0%, #0c1b2b 52%, #0e2730 100%)'
            : 'linear-gradient(135deg, #eef6ff 0%, #e8f4fb 52%, #effaf6 100%)',
        '&::before': {
          content: '""',
          position: 'absolute',
          inset: 0,
          pointerEvents: 'none',
          background: `
            radial-gradient(circle at 20% 22%, rgba(99, 182, 219, 0.1), transparent 30%),
