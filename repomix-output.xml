                  />
                  <Typography
                    variant="caption"
                    sx={{
                      color: optionValues[optionKey]
                        ? 'var(--color-success)' : 'var(--color-error)',
                      fontWeight: 700,
                    }}
                  >
                    {valueLabel}
                  </Typography>
                </Stack>
              </Stack>
            );
          })}
        </Stack>
      </Box>
    </BlurModal>
  );
};

