                MenuListProps={{
                  sx: {
                    py: 0,
                    '& .MuiMenuItem-root': {
                      borderRadius: 1,
                      px: 2,
                      py: 1.25,
                      typography: 'body2',
                      color: 'var(--color-text)',
                      transition:
                        'background-color 0.2s ease, transform 0.2s ease',
                      '&:not(:last-of-type)': {
                        mb: 0.5,
