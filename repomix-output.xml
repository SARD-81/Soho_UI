                    backgroundColor:
                      'color-mix(in srgb, var(--color-background) 50%, transparent)',
                    border:
                      '1px solid color-mix(in srgb, var(--color-input-border) 58%, transparent)',
                    boxShadow: 'inset 0 1px 0 rgba(255,255,255,0.06)',
