      'با تایید این پیام سیستم خاموش می‌شود و برای ادامه کار باید آن را دوباره روشن کنید. لطفاً از ذخیره اطلاعات مهم اطمینان حاصل کنید.',
  },
};

const PowerActionConfirmDialog: React.FC<PowerActionConfirmDialogProps> = ({
