      const sizeSuffix = sizeUnit === 'GB' ? 'G' : 'T';
      const payload: CreateVolumePayload = {
        volume_name: `${trimmedPool}/${trimmedName}`.replace(/\s+/g, ''),
        volsize: `${trimmedSize}${sizeSuffix}`.replace(/\s+/g, ''),
      };

      createVolumeMutation.mutate(payload);
