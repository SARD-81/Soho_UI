          <Controller
            name="username"
            control={control}
            render={({ field }) => (
              <TextField
                {...field}
                placeholder="نام کاربری مدیریتی"
                autoComplete="username"
                fullWidth
                error={!!errors.username}
                helperText={errors.username?.message}
                slotProps={{
                  input: {
                    startAdornment: (
                      <InputAdornment position="start">
                        <Box
                          sx={{
                            width: 34,
                            height: 34,
                            display: 'grid',
                            placeItems: 'center',
                            borderRadius: '12px',
                            color: 'var(--color-primary)',
                            background: 'rgba(99, 182, 219, 0.12)',
                          }}
                        >
                          <FaUser size={15} />
                        </Box>
                      </InputAdornment>
                    ),
                  },
                }}
                sx={loginTextFieldSx}
              />
            )}
          />
        </Stack>

        <Stack spacing={0.8}>
          <Typography component="label" sx={fieldLabelSx}>
            رمز عبور
