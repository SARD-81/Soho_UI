            >
              {icon}
            </Box>

            <Typography
              component="h3"
              sx={{
                m: 0,
                minWidth: 0,
                fontWeight: 800,
                fontSize: "1.02rem",
                lineHeight: 1.9,
                color: "var(--color-text)",
                textAlign: "start",
