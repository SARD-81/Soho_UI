              ) : (
                <Button
                  onClick={handleUserMenuOpen}
                  endIcon={<IoPersonCircleOutline size={24} />}
                  sx={{
                    color: 'var(--color-text)',
                    display: 'flex',
                    alignItems: 'center',
                    gap: 1,
                    px: 1.5,
                    py: 0.7,
                    borderRadius: 999,
