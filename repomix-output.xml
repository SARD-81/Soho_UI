          </Typography>
          {DISPLAY_OPTIONS.map((optionKey) => {
            const label = translateDetailKey(optionKey);
            const valueLabel = optionValues[optionKey] ? 'فعال' : 'غیرفعال';

            return (
              <Stack
                key={optionKey}
                direction="row"
                spacing={2}
                alignItems="center"
